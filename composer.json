{
    "name": "go4taste/recipes-plugin",
    "description": "WordPress plugin for recipe content structure with ACF Blocks",
    "type": "wordpress-plugin",
    "license": "proprietary",
    "require": {
        "php": ">=8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0",
        "wp-coding-standards/wpcs": "^3.0",
        "phpstan/phpstan": "^1.10"
    },
    "autoload": {
        "files": [
            "includes/slices/recipe-composition/index.php",
            "includes/slices/recipe-registration/index.php",
            "includes/slices/recipe-storage/index.php",
            "includes/slices/recipe-read-model/index.php",
            "includes/slices/recipe-admin-config/index.php",
            "includes/slices/recipe-input-surface/index.php",
            "includes/slices/recipe-output-surface/index.php"
        ]
    },
    "scripts": {
        "test": "phpunit",
        "test:unit": "phpunit tests/unit",
        "phpstan": "phpstan analyse includes --level=8"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
